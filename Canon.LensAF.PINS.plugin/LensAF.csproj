<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Library</OutputType>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <DefaultItemExcludes Condition="$([System.Runtime.InteropServices.RuntimeInformation]::IsOSPlatform($([System.Runtime.InteropServices.OSPlatform]::Linux)))">$(DefaultItemExcludes);**/*.xaml.cs;**/*.xaml</DefaultItemExcludes>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.2" />
    <ProjectReference Include="..\..\..\NINA.Core\NINA.Core.csproj" />
    <ProjectReference Include="..\..\..\NINA.CustomControlLibrary\NINA.CustomControlLibrary.csproj" />
    <ProjectReference Include="..\..\..\NINA.Equipment\NINA.Equipment.csproj" />
    <ProjectReference Include="..\..\..\NINA.Image\NINA.Image.csproj" />
    <ProjectReference Include="..\..\..\NINA.Plugin\NINA.Plugin.csproj" />
    <ProjectReference Include="..\..\..\NINA.Profile\NINA.Profile.csproj" />
    <ProjectReference Include="..\..\..\NINA.Sequencer\NINA.Sequencer.csproj" />
    <ProjectReference Include="..\..\..\NINA.WPF.Base\NINA.WPF.Base.csproj" />
    <PackageReference Include="System.Data.DataSetExtensions" Version="4.5.0" />
    <!-- <PackageReference Include="System.Drawing.Common" Version="*" ExcludeAssets="all" /> -->
  </ItemGroup>
  <ItemGroup>
    <Compile Update="Properties\Settings.Designer.cs">
      <DesignTimeSharedInput>True</DesignTimeSharedInput>
      <AutoGen>True</AutoGen>
      <DependentUpon>Settings.settings</DependentUpon>
    </Compile>
  </ItemGroup>
  <ItemGroup>
    <None Update="Properties\Settings.settings">
      <Generator>SettingsSingleFileGenerator</Generator>
      <LastGenOutput>Settings.Designer.cs</LastGenOutput>
    </None>
  </ItemGroup>
  <PropertyGroup />
  <Target Name="PostBuildLinux" AfterTargets="PostBuildEvent" Condition="$([System.Runtime.InteropServices.RuntimeInformation]::IsOSPlatform($([System.Runtime.InteropServices.OSPlatform]::Linux)))">
    <Exec Command="mkdir -p $HOME/.local/share/NINA/Plugins/3.0.0/Canon\ Lens\ AF\ PINS" />
    <Exec Command="cp $(TargetPath) $HOME/.local/share/NINA/Plugins/3.0.0/Canon\ Lens\ AF\ PINS/$(TargetName)$(TargetExt)" />
  </Target>
</Project>